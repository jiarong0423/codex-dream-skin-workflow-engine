          "path": "icons/buttons/cat-paw-new-task.svg",
          "mediaType": "image/svg+xml",
          "bytes": 650,
          "runtime": true,
          "preview": true
        },
        {
          "id": "project",
          "label": "Project",
          "labelZh": "專案",
          "path": "icons/buttons/neko-chip-project.svg",
          "mediaType": "image/svg+xml",
          "bytes": 659,
          "runtime": true,
          "preview": true
        },
        {
          "id": "search",
          "label": "Search",
          "labelZh": "搜尋",
          "path": "icons/buttons/cat-eye-search.svg",
          "mediaType": "image/svg+xml",
          "bytes": 903,
          "runtime": true,
          "preview": true
        },
        {
          "id": "settings",
          "label": "Settings",
          "labelZh": "設定",
          "path": "icons/buttons/mecha-ear-settings.svg",
          "mediaType": "image/svg+xml",
          "bytes": 599,
          "runtime": true,
