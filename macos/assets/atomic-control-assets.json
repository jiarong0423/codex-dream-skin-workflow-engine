          "labelZh": "橘色機器貓備選",
          "path": "icons/cyber-robot-orange-cat-512.png",
          "mediaType": "image/png",
          "width": 512,
          "height": 512,
          "bytes": 321395,
          "runtime": true,
          "preview": true
        }
      ]
    },
    {
      "id": "tableFlipCat",
      "label": "Table Flip Cat",
      "labelZh": "翻桌貓",
      "mount": "manual-trigger-preview",
      "policy": "manual trigger only; playback asset must not be resident before click",
      "items": [
        {
          "id": "tableFlipTrigger",
          "label": "Trigger icon",
          "labelZh": "觸發圖示",
          "path": "icons/table-flip-trigger-angry.svg",
          "mediaType": "image/svg+xml",
          "bytes": 2386,
          "runtime": true,
          "preview": true
        },
        {
          "id": "tableFlipSpriteWebp",
          "label": "Sprite WebP",
          "labelZh": "WebP sprite",
          "path": "icons/table-flip-cat-left-sprite.webp",
          "mediaType": "image/webp",
          "width": 2880,
          "height": 250,
          "bytes": 151278,
          "runtime": true,
          "preview": false
        },
        {
          "id": "tableFlipGifFallback",
          "label": "GIF fallback",
          "labelZh": "GIF 後備",
          "path": "icons/table-flip-cat-left.gif",
          "mediaType": "image/gif",
          "width": 360,
          "height": 250,
          "bytes": 264469,
          "runtime": false,
          "preview": false
        }
      ]
    },
    {
      "id": "buttonGlyphs",
      "label": "Button Glyphs",
      "labelZh": "按鈕圖示",
      "mount": "semantic-button-preview",
      "policy": "opt-in semantic symbols; never broad icon replacement",
      "items": [
        {
          "id": "newTask",
