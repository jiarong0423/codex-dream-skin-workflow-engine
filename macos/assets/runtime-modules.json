{
  "version": 1,
  "policy": {
    "principle": "subtractive module aggregation",
    "rendererMaintenanceMs": 2500,
    "heavyMaintenanceMs": 10000,
    "assetLoad": "only package assets referenced by enabled theme modules",
    "animationLoad": "static cache lookup after manual trigger; sprite first, GIF fallback only when sprite is unavailable",
    "gpuComposition": "single non-fixed three-layer body wallpaper; no idle backdrop blur on full-size or repeated surfaces; no per-icon filter stack"
  },
  "boundaryPolicy": {
    "identity": "dom-structure-or-payload-owner",
    "geometryRole": "qualification-and-placement-only",
    "ownerRule": "one owner per native boundary; theme-owned nodes and native-owned nodes cannot claim each other",
    "lifecycleRule": "install, route, light, and cleanup are explicit module phases",
    "forbidden": [
      "fixed-coordinate identity",
      "text-only identity",
      "global repaint overlay",
      "second full-page observer"
    ]
  },
  "dynamicBoundaryLocks": {
    "version": 1,
    "strategy": "lock native source modules before visual paint and treat geometry as evidence only",
    "lockStateContract": [
      "candidate",
      "locked",
      "quarantined",
      "released"
    ],
    "invariants": [
      "native-owned dynamic modules are classified before theme-owned style modules can affect them",
      "locked modules keep their official geometry, pointer behavior, drag behavior, and resize behavior",
      "theme code may add only namespaced data markers and reset-only quarantine classes to native-owned locks",
      "classification uses source signals and DOM ownership before geometry; fixed coordinates are never identity",
      "high-memory media preview surfaces are inventory-only unless a future reviewed tool explicitly opts in",
      "surface preflight cleans only namespaced theme markers before black shell paint",
      "protected native primitives are excluded before black shell candidate selection"
    ],
    "surfaces": [
      {
        "id": "sourcePreviewBlocks",
        "owner": "native",
        "lockKey": "data-cit-source-preview-block",
        "sourceSignals": [
          "source thumbnail",
          "screenshot thumbnail",
          "attachment preview",
          "resizable media preview",
          "right-side source rail"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "reset-only-quarantine",
          "restore-marker"
        ],
        "forbiddenActions": [
          "drag",
          "resize",
          "recolor",
          "blur",
          "scale",
          "transform",
          "overlay",
          "fixed-coordinate-identity",
          "opacity-detection-only"
        ],
        "riskTags": [
          "high-memory-image-resize",
          "dynamic-native-preview",
          "thumbnail-recompression"
        ]
      },
      {
        "id": "rightTopChips",
        "owner": "native",
        "lockKey": "data-cit-right-top-chip",
        "sourceSignals": [
          "top toolbar chip",
          "attachment chip",
          "source chip",
          "open mode chip",
          "close chip"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "restore-marker"
        ],
        "forbiddenActions": [
          "recolor",
          "black-shell-fill",
          "duplicate-plate",
          "fixed-coordinate-identity",
          "text-only-identity"
        ],
        "riskTags": [
          "dynamic-chip-stack",
          "right-toolbar-overlap"
        ]
      },
      {
        "id": "leftSidebarRows",
        "owner": "native",
        "lockKey": "data-cit-left-sidebar-row",
        "sourceSignals": [
          "new chat row",
          "project row",
          "pull request row",
          "website row",
          "scheduled task row",
          "connector row",
          "selected recent project row"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "selected-state-read",
          "restore-marker"
        ],
        "forbiddenActions": [
          "multi-select-paint",
          "duplicate-active-border",
          "global-row-background",
          "fixed-coordinate-identity"
        ],
        "riskTags": [
          "native-selection-state",
          "collapsed-sidebar-preview"
        ]
      },
      {
        "id": "projectPanelRows",
        "owner": "native",
        "lockKey": "data-cit-project-panel-row",
        "sourceSignals": [
          "project list row",
          "pin action",
          "edit action",
          "more menu",
          "search project panel"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "collision-read",
          "restore-marker"
        ],
        "forbiddenActions": [
          "hide-action-icons",
          "duplicate-active-border",
          "global-row-background",
          "fixed-coordinate-identity"
        ],
        "riskTags": [
          "native-list-actions",
          "dynamic-panel-width"
        ]
      },
      {
        "id": "accountPopover",
        "owner": "native",
        "lockKey": "data-cit-account-popover",
        "sourceSignals": [
          "usage menu",
          "pet menu",
          "settings row",
          "logout row",
          "account identity row"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "restore-marker"
        ],
        "forbiddenActions": [
          "click",
          "state-mutation",
          "permission-mutation",
          "logout",
          "recolor",
          "fixed-coordinate-identity"
        ],
        "riskTags": [
          "account-state",
          "permission-state"
        ]
      },
      {
        "id": "composerSurface",
        "owner": "native",
        "lockKey": "data-cit-composer-surface-lock",
        "sourceSignals": [
          "native composer",
          "model picker",
          "voice button",
          "send button",
          "approval chip"
        ],
        "allowedActions": [
          "classify",
          "inventory",
          "native-size-reset",
          "restore-marker"
        ],
        "forbiddenActions": [
          "full-width-overlay",
          "black-shell-fill",
          "input-intercept",
          "fixed-coordinate-identity"
        ],
        "riskTags": [
          "text-input",
          "bottom-dock"
        ]
      },
      {
        "id": "blackShellTransparency",
        "owner": "native",
        "lockKey": "data-cit-black-shell",
        "sourceSignals": [
          "large near-black native shell",
          "preflight cleanup passed",
          "protected native primitive exclusion passed",
          "protected native container exclusion passed",
          "marker-only CSS material boundary"
        ],
        "allowedActions": [
          "classify",
          "cleanup-own-black-shell-marker",
          "exclude-protected-native-primitive",
          "exclude-protected-native-container",
          "alpha-reduce-shell-background",
          "remove-shell-background-image",
          "restore-marker"
        ],
        "forbiddenActions": [
          "resize",
          "reposition",
          "transform",
          "overflow-change",
          "z-index-change",
          "media-mutation",
          "mcp-content-restyle",
          "editor-content-restyle",
          "fixed-coordinate-identity"
        ],
        "riskTags": [
          "official-black-shell",
          "dynamic-native-container",
          "background-layer-occlusion"
        ]
      }
    ]
  },
  "budgets": {
    "themeCssBytes": 130000,
    "rendererBytes": 120000,
    "runtimePayloadBytes": 9000000,
    "singleIconBytes": 4194304,
    "buttonIconBytes": 262144
  },
  "retainedSourceAssets": [
    "backgrounds/cyber-ruins-pale.png",
    "backgrounds/cyberpunk-contrast-city.png",
    "icons/cyber-mecha-cat-male-helmet-chroma.png",
    "icons/cyber-mecha-cat-male-helmet-cutout.png",
    "icons/cyber-robot-orange-cat-768.png",
    "icons/cyber-robot-orange-cat-chroma.png",
    "icons/cyber-robot-orange-cat-cutout.png",
    "icons/orange-hacker-cat-chroma.png",
    "icons/orange-hacker-cat-cutout.png",
    "icons/table-flip-cat-left.webp"
  ],
  "styleEntry": "theme-kernel.css",
  "frameworkStyleEntry": "theme-framework.css",
  "carrierStyleEntry": "theme-carrier.css",
  "controlStyleEntry": "theme-control.css",
  "rendererEntry": "renderer-inject.js",
  "controlRendererEntry": "renderer-control.js",
  "loadModes": {
    "visual": {
      "runtimeMode": "visual",
      "styleEntry": "theme-kernel.css",
      "rendererEntry": "renderer-inject.js",
      "assetGroups": [
        "runtimeBackground",
        "sidebarBadge",
        "heroCharacter",
        "tableFlipCat",
        "buttonGlyphs"
      ],
      "rendererPolicy": "all declared runtime modules"
    },
    "carrier-only": {
      "runtimeMode": "carrier-only",
      "styleEntry": "theme-carrier.css",
      "rendererEntry": "renderer-inject.js",
      "assetGroups": [],
      "rendererPolicy": "native boundary, composer, conversation, workspace picker, collision, and marker modules only"
    },
    "framework-only": {
      "runtimeMode": "framework-only",
      "styleEntry": "theme-framework.css",
      "rendererEntry": "renderer-inject.js",
      "assetGroups": [],
      "rendererPolicy": "marker-only restore-safe sentinel mode"
    },
    "control-only": {
      "runtimeMode": "control-only",
      "styleEntry": "theme-control.css",
      "rendererEntry": "renderer-control.js",
      "assetGroups": [],
      "rendererPolicy": "offline atomic command planner control panel only; no visual assets, no surface registry, no style modules, no shell execution"
    }
  },
  "modules": [
    {
      "id": "background",
      "kind": "asset",
      "activation": "backgroundImagePath",
      "payloadKeys": [
        "backgroundDataUrl"
      ],
      "loadPolicy": "active-theme-only",
      "disableValue": ""
    },
    {
      "id": "iconBadge",
      "kind": "asset",
      "activation": "icons.badge.enabled && icons.badge.placement !== off",
      "payloadKeys": [
        "iconBadgeDataUrl"
      ],
      "loadPolicy": "enabled-only"
    },
    {
      "id": "character",
      "kind": "asset",
      "activation": "icons.character.enabled && icons.character.placement !== off",
      "payloadKeys": [
        "characterDataUrl"
      ],
      "loadPolicy": "enabled-only"
    },
    {
      "id": "characterRetreat",
      "kind": "dom-geometry",
      "activation": "icons.character.enabled && renderer-detected",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset",
      "eventPolicy": "hide character when right panel is visible or text-line overlap is detected"
    },
    {
      "id": "staticAccess",
      "kind": "dom-cache",
      "activation": "renderer-module-registry",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset",
      "eventPolicy": "cache stable DOM entrypoints; invalidate on install, route, low-frequency mutation, resize, and right-trigger"
    },
    {
      "id": "collisionScheduler",
      "kind": "scheduler",
      "activation": "renderer-module-registry",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset",
      "eventPolicy": "shared layout observer plus top-right preflight trigger; no second full-page observer"
    },
    {
      "id": "sourcePreviewQuarantine",
      "kind": "dom-class",
      "activation": "renderer-detected source preview blocks",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset",
      "eventPolicy": "reset-only marker quarantine for source previews; does not drag or restyle native media"
    },
    {
      "id": "tableFlipCat",
      "kind": "manual-animation",
      "activation": "icons.tableFlipCat.enabled && icons.tableFlipCat.placement === right-bottom",
      "payloadKeys": [
        "tableFlipCatTriggerIconDataUrl",
        "loadTableFlipCatPlayback"
      ],
      "loadPolicy": "static-cache-click",
      "eventPolicy": "idle trigger only, create animation node after click, play once, release node and image reference"
    },
    {
      "id": "themePacks",
      "kind": "developer-extension",
      "activation": "theme-packs/*/pack.json with at least two asset-ready-unmounted packs",
      "payloadKeys": [
        "themePackDataUrls"
      ],
      "loadPolicy": "manifest-plus-file-url-candidates",
      "eventPolicy": "right HUD transparent bay plus dropdown selector switches CSS variables and file-url asset references; no base64 candidate payload, no polling, no daemon, and no idle playback DOM"
    },
    {
      "id": "workspacePickers",
      "kind": "dom-class",
      "activation": "event-triggered workspace picker geometry and text detection",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset",
      "eventPolicy": "short follow-up checks after pointer, click, keydown, or focusin; marks only the picker shell while visible; no detached overlay plate"
    },
    {
      "id": "buttonGlyphs",
      "kind": "asset-map",
      "activation": "icons.buttons.enabled && icons.buttons.applyMode === module",
      "payloadKeys": [
        "iconButtonDataUrls"
      ],
      "loadPolicy": "enabled-module-only"
    },
    {
      "id": "projectPanels",
      "kind": "dom-class",
      "activation": "renderer-detected",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset"
    },
    {
      "id": "composerSurface",
      "kind": "dom-class",
      "activation": "renderer-detected",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset"
    },
    {
      "id": "conversationSurface",
      "kind": "dom-class",
      "activation": "renderer-detected",
      "payloadKeys": [],
      "loadPolicy": "no-extra-asset"
    }
  ],
  "matrix": [
    {
      "scenario": "default-theme",
      "expected": "passes module manifest and file budgets"
    },
    {
      "scenario": "active-theme",
      "expected": "old active theme is normalized with runtime defaults before payload assembly"
    },
    {
      "scenario": "table-flip-enabled",
      "expected": "sprite is stored by content hash and only attached to a DOM node after trigger click"
    },
    {
      "scenario": "table-flip-disabled",
      "expected": "sprite, poster, trigger, and GIF payloads are not planned"
    },
    {
      "scenario": "button-glyphs-disabled",
      "expected": "button SVG map is not packaged"
    },
    {
      "scenario": "asset-budget",
      "expected": "runtime referenced assets stay under payload budget; declared design sources stay outside the runtime payload; unclassified heavy assets are reported"
    },
    {
      "scenario": "theme-packs-extension",
      "expected": "developer theme packs expose at least two hot-swap candidates through a transparent bay/dropdown without changing the native frame or preloading playback DOM"
    }
  ]
}
