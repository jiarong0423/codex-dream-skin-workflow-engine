#!/usr/bin/env bash
set -euo pipefail

APP_TITLE="Chainsaw Duel Injector"
STATE_DIR="$HOME/Library/Application Support/DreamSkinForge"
INSTALLED_PROJECT_ROOT="$STATE_DIR/chainsaw-project"
CANONICAL_PROJECT_ROOT="$HOME/Developer/skin"
LEGACY_PROJECT_ROOT="$HOME/Documents/skin"
PORT="${CIT_PRIVATE_DUEL_PORT:-9341}"
WAIT_MS="${CIT_PRIVATE_DUEL_WAIT_MS:-8000}"
RUN_GATE="${CIT_PRIVATE_DUEL_GATE:-true}"
LOG_DIR="$STATE_DIR/logs"
LOG_FILE="$LOG_DIR/chainsaw-duel-injector.log"

mkdir -p "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1

timestamp() {
  date '+%Y-%m-%d %H:%M:%S'
}

log() {
  printf '[%s] %s\n' "$(timestamp)" "$*"
}

notify() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "Chainsaw Duel Injector"' \
    -e 'end run' \
    "$1" >/dev/null 2>&1 || true
}

alert() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display dialog (item 1 of argv) buttons {"OK"} default button "OK" with title "Chainsaw Duel Injector"' \
    -e 'end run' \
    "$1" >/dev/null 2>&1 || true
}

resolve_project_root() {
  local launcher_source="${BASH_SOURCE[0]}"
  local executable_dir
  local bundled_root
  local candidate
  local resolved_candidate
  local -a candidates=()

  while [ -h "$launcher_source" ]; do
    executable_dir="$(cd -P "$(dirname "$launcher_source")" >/dev/null 2>&1 && pwd)"
    launcher_source="$(readlink "$launcher_source")"
    case "$launcher_source" in
      /*) ;;
      *) launcher_source="$executable_dir/$launcher_source" ;;
    esac
  done

  executable_dir="$(cd -P "$(dirname "$launcher_source")" >/dev/null 2>&1 && pwd)"
  bundled_root="$(cd -P "$executable_dir/../../../../.." >/dev/null 2>&1 && pwd || true)"

  if [ -n "${DREAM_SKIN_PROJECT_ROOT:-}" ]; then
    candidates+=("$DREAM_SKIN_PROJECT_ROOT")
  fi
  candidates+=(
    "$bundled_root"
    "$INSTALLED_PROJECT_ROOT"
    "$CANONICAL_PROJECT_ROOT"
    "$LEGACY_PROJECT_ROOT"
  )

  for candidate in "${candidates[@]}"; do
    [ -n "$candidate" ] || continue
    if [ -x "$candidate/macos/scripts/chainsaw-duel-one-click-injector.sh" ]; then
      resolved_candidate="$(cd -P "$candidate" >/dev/null 2>&1 && pwd)"
      printf '%s\n' "$resolved_candidate"
      return 0
    fi
  done

  printf '[Chainsaw Duel Injector][error] no usable project root found; checked candidates:\n' >&2
  printf '  %s\n' "${candidates[@]}" >&2
  return 1
}

log "desktop app started"

if ! PROJECT_ROOT="$(resolve_project_root)"; then
  log "unable to resolve project root"
  alert "找不到 Chainsaw Duel 注入器。請確認專案、已安裝 runtime 或 DREAM_SKIN_PROJECT_ROOT。Log: ${LOG_FILE}"
  exit 1
fi
INJECTOR="$PROJECT_ROOT/macos/scripts/chainsaw-duel-one-click-injector.sh"

if [ ! -x "$INJECTOR" ]; then
  log "missing executable injector at $INJECTOR"
  alert "找不到 Chainsaw Duel 注入器。請確認專案仍在 $PROJECT_ROOT，或設定 DREAM_SKIN_PROJECT_ROOT。也可以改用 Desktop 的 Chainsaw Duel Injector.command。Log: ${LOG_FILE}"
  exit 1
fi

log "project_root=$PROJECT_ROOT port=$PORT wait_ms=$WAIT_MS gate=$RUN_GATE"
notify "正在開啟 9341 並注入 Chainsaw Duel。"

if /bin/bash "$INJECTOR" --port "$PORT" --wait-ms "$WAIT_MS" --gate "$RUN_GATE"; then
  log "desktop app apply completed"
  notify "Chainsaw Duel 已套用。"
  exit 0
else
  status="$?"
fi

log "desktop app apply failed status=$status"
alert "Chainsaw Duel 注入失敗。請查看 log：${LOG_FILE}。若 .app 被 macOS 擋住，請改用 Desktop 的 Chainsaw Duel Injector.command。"
exit "$status"
